{
  "name": "CECS 326 Lab 2: The Dungeon",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": false,
      "upgradePackages": true
    }
  },
  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y build-essential gdb make",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.makefile-tools"
      ]
    }
  },
  "remoteUser": "vscode"
}
